#!/usr/bin/env bash

ensure-line() {
  local file="$1" line="$2" name="$3"
  if [[ ! -f "$file" ]]; then
    echo "$name $(basename "$file") not found, skipping" >&2
    return
  fi

  if grep -qxF "$line" "$file"; then
    echo "$name: already configured"
    return
  fi

  printf '%s\n' "$line" >> "$file"
  echo "$name: added"
}

uncomment-line() {
  local file="$1" line="$2" name="$3"
  if [[ ! -f "$file" ]]; then
    echo "$name $(basename "$file") not found, skipping" >&2
    return
  fi

  if grep -qF "$line" "$file"; then
    echo "$name: already enabled"
    return
  fi

  local fixed
  fixed=$(sed "s|^[[:space:]]*#\{1,\}[[:space:]]*${line//\\/\\\\}.*|	$line|" "$file")
  printf '%s\n' "$fixed" > "$file"
  echo "$name: enabled"
}

# Niri
ensure-line "$HOME/.config/niri/config.kdl" 'include "./cfg/custom.kdl"' "niri"

# Alacritty

uncomment-line "$HOME/.config/alacritty/alacritty.toml" '"~/.config/alacritty/themes/noctalia.toml",' "alacritty noctalia theme"

echo "Set locale to en_US"
localectl set-locale en_US.UTF-8

if [[ "$USER" == "pervez" ]]; then
  echo "git config"
  git config --global user.name "Pervez Iqbal"
  git config --global user.email "pervezfunctor@gmail.com"
  git config --global init.defaultBranch main
fi